{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy:hosting": "pnpm build && cd .. && pnpm dlx firebase-tools@latest deploy --only hosting",
