{
  "name": "client",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev --port 4200",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "deploy:hosting": "pnpm build && pnpm --dir .. dlx firebase-tools@latest deploy --only hosting",
    "audit": "pnpm audit",
    "audit:ci": "pnpm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
