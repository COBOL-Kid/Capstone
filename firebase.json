{
  "hosting": {
    "public": "Client/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "honest-car-server",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/fallback.html"
      }
    ],
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "private"
          }
        ]
      }
    ]
  }
}
